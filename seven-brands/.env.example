# Copy to .env and adjust. Never commit real secrets.
DATABASE_URL=postgres://daos:daos_dev_only@localhost:5432/daos_dev
TEST_DATABASE_URL=postgres://daos:daos_dev_only@localhost:5432/daos_test

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
ADMIN_BASE_URL=http://localhost:3100

# Storage: "fs" (local dev) or "s3" (R2 / S3 / MinIO)
STORAGE_DRIVER=fs
# Use an absolute path: the admin, storefront and worker run from different folders and must share files.
STORAGE_FS_ROOT=/absolute/path/to/seven-brands/.data/storage
STORAGE_SIGNING_SECRET=
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=daos-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI production (Phase 2). Leave the key empty to disable AI jobs.
DAOS_ANTHROPIC_API_KEY=
DAOS_ANTHROPIC_MODEL=claude-opus-5-5
DAOS_AI_DAILY_BUDGET_USD=5
DAOS_AI_MONTHLY_BUDGET_USD=50
# DAOS_AI_PROVIDER=fixture   # labelled demo mode with recorded outputs (not AI)

# Commerce (Phase 3). COMMERCE_PROVIDER picks the checkout provider: lemonsqueezy | paddle | test.
# Every provider with complete settings also accepts webhooks at /api/webhooks/<provider> on the storefront.
# Live (non-test) credentials are refused unless COMMERCE_LIVE_PAYMENTS=enabled (owner decision, after the validation gate).
COMMERCE_PROVIDER=test
# COMMERCE_LIVE_PAYMENTS=enabled
# Labelled test provider for local development only (no money moves; never set on a public deployment).
COMMERCE_TEST_SECRET=
# DEPLOY_ENV=production   # blocks the test provider entirely

# Lemon Squeezy (test mode): one store, one "Digital asset" product variant whose price is overridden per checkout.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_TEST_MODE=true
# LEMONSQUEEZY_CURRENCY=USD

# Paddle Billing (sandbox): one catalog product (pro_…) that non-catalog prices attach to.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_PRODUCT_ID=
PADDLE_WEBHOOK_SECRET=
# Client-side token for Paddle.js on /checkout/paddle (public by design).
PADDLE_CLIENT_TOKEN=
# PADDLE_CURRENCIES=USD
