{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "typecheck": {},
    "test": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": [
    "CHROMIUM_PATH",
    "DAOS_ANTHROPIC_API_KEY",
    "DAOS_ANTHROPIC_BASE_URL",
    "DATABASE_URL",
    "E2E_DATABASE_URL",
    "FFMPEG_PATH",
    "MOTO_SERVER_BIN",
    "PLAYWRIGHT_BROWSERS_PATH",
    "TEST_DATABASE_URL"
  ]
}
