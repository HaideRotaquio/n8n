# Staging settings (copy to .env.staging; never commit the real file). Test-mode payments only.
DEPLOY_ENV=staging
DATABASE_URL=postgres://USER:PASSWORD@HOST.neon.tech/daos?sslmode=require
BETTER_AUTH_SECRET=            # openssl rand -base64 32
ADMIN_BASE_URL=https://admin.staging.example.com

STORAGE_DRIVER=s3
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=daos-staging
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_SIGNING_SECRET=        # openssl rand -base64 32

# Payments: test mode / sandbox only on staging (see docs/PAYMENTS_SETUP.md). Leave COMMERCE_LIVE_PAYMENTS unset.
COMMERCE_PROVIDER=lemonsqueezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_TEST_MODE=true
# PADDLE_ENVIRONMENT=sandbox
# PADDLE_API_KEY=
# PADDLE_PRODUCT_ID=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_CLIENT_TOKEN=

# AI (optional): keep the spend caps low on staging.
DAOS_ANTHROPIC_API_KEY=
DAOS_AI_DAILY_BUDGET_USD=2
DAOS_AI_MONTHLY_BUDGET_USD=20
